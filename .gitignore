# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
.env*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# pdf.js assets, copied from node_modules on install
/public/pdfjs/

# QPDF WebAssembly assets, copied from node_modules on install
/public/pdf-wasm/

# Tesseract.js OCR worker, WASM cores and tessdata_fast models, copied from node_modules on install
/public/ocr/

# 3D viewer assets (Open CASCADE, Draco, Basis Universal), copied from node_modules on install
/public/3d/

# QR code reader (zxing-wasm), copied from node_modules on install
/public/qr/

# Self-hosted Monaco Editor bundle, copied from node_modules on install
/public/monaco/

# Self-hosted site fonts (Inter, JetBrains Mono), copied from node_modules on install
/public/fonts/

# Self-hosted Pyodide runtime, curated wheels, and xterm CSS, copied/downloaded on install
/public/pyodide/
/public/python/rt/
/public/python/xterm.css

# Licence list, generated from node_modules on install
/lib/generated/

# Sitemap, generated from pages/ on install
/public/sitemap.xml

# TypeScript incremental build info (npx tsc --noEmit)
*.tsbuildinfo



