# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
.env*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# pdf.js assets, copied from node_modules on install
/public/pdfjs/

# 3D viewer assets (Open CASCADE, Draco, Basis Universal), copied from node_modules on install
/public/3d/

# Licence list, generated from node_modules on install
/lib/generated/

# TypeScript incremental build info (npx tsc --noEmit)
*.tsbuildinfo
